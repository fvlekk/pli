# Copy to .env for local runs. Never commit .env.
# Without a key the backend uses the rule extractor (PLI_EXTRACTEUR=auto).
ANTHROPIC_API_KEY=
PLI_EXTRACTEUR=auto
PLI_MODELE=claude-opus-5-5
PLI_EFFORT=medium
PLI_ORIGINES_CORS=http://localhost:5173,http://127.0.0.1:5173
PLI_REQUETES_PAR_MINUTE=10
PLI_REQUETES_PAR_MINUTE_INSTANCE=60
# Daily caps, in memory: they back up the spend limit set on the Anthropic workspace.
PLI_REQUETES_PAR_JOUR=30
PLI_REQUETES_PAR_JOUR_INSTANCE=500
# Above this, a reading is refused (503, retry): it bounds the memory used by large files.
PLI_LECTURES_SIMULTANEES=4
# PDFs over this many pages are refused before any extractor runs.
PLI_PAGES_MAX=10
# App Check token required by default. 0 = checked and logged only (off by itself with PLI_AUTH_EMULATEUR=1).
# PLI_APP_CHECK=0
# Local emulator only (the server refuses to start with the emulator host set otherwise):
# PLI_AUTH_EMULATEUR=1
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
